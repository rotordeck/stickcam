// Deploy target: Cloudflare Workers static assets (https://stickcam.<account>.workers.dev).
// `npm run build && npm run deploy` publishes dist/. The site is plain static files,
// so no Worker script is needed: only the assets binding.
{
  "name": "stickcam",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    // One page, no client-side routing: serve index.html for the root only.
    "not_found_handling": "none"
  }
}
